<?xml version="1.0" encoding="UTF-8"?>
<!-- Peak stress run (M3): 08:00-10:30, 08:00-08:30 warm-up, analysis
     08:30-10:30. Options from sim/stress-options.txt (rationale there). -->
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="net/corridor-calibrated.net.xml"/>
        <route-files value="demand/baseline.rou.xml"/>
    </input>
    <time>
        <begin value="28800"/>
        <end value="37800"/>
    </time>
    <processing>
        <time-to-teleport value="600"/>
        <ignore-junction-blocker value="60"/>
        <lateral-resolution value="0.8"/>
    </processing>
    <output>
        <statistic-output value="../results/stress_stats.xml"/>
    </output>
    <report>
        <duration-log.statistics value="true"/>
        <no-warnings value="true"/>
    </report>
</sumoConfiguration>
