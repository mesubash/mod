<?xml version="1.0" encoding="UTF-8"?>
<!-- M3 baseline run: 06:00-12:00 wall clock (21600-43200 s, matching the
     depart times duarouter wrote into baseline.rou.xml). Analysis window
     08:00-11:00 = 28800-39600 s. queue-output sampled every 60 s for
     Q_i / t_diss; meanData outputs defined in baseline.add.xml. -->
<sumoConfiguration>
    <input>
        <net-file value="net/corridor-filtered.net.xml"/>
        <route-files value="demand/baseline.rou.xml"/>
        <additional-files value="baseline.add.xml"/>
    </input>
    <time>
        <begin value="21600"/>
        <end value="43200"/>
    </time>
    <output>
        <statistic-output value="../results/baseline_stats.xml"/>
        <queue-output value="../results/baseline_queues.xml"/>
        <queue-output.period value="60"/>
    </output>
    <processing>
        <threads value="4"/>
    </processing>
    <report>
        <no-step-log value="true"/>
        <duration-log.statistics value="true"/>
    </report>
</sumoConfiguration>
